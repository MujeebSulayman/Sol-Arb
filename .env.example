# --- Connection ---------------------------------------------------------
# Alchemy: paste your API key from dashboard.alchemy.com (create an app on
# Solana Mainnet). The bot builds the endpoint URLs from it:
#   https://solana-mainnet.g.alchemy.com/v2/<key>
#   wss://solana-mainnet.g.alchemy.com/v2/<key>
ALCHEMY_API_KEY=

# Or set a full RPC URL from any provider. If set, it overrides ALCHEMY_API_KEY.
# With neither set, the public RPC is used (too slow for real arbitrage).
RPC_URL=
WS_URL=

# Jupiter Swap API. Without a key you get 30 requests/min; a free key from
# https://developers.jup.ag/portal gives 60/min. The bot throttles itself to
# stay under the limit (override with JUPITER_RPS if your plan allows more).
JUPITER_API_URL=https://api.jup.ag/swap/v1
JUPITER_API_KEY=
JUPITER_RPS=

# --- Wallet -------------------------------------------------------------
# Base58 secret key of a DEDICATED hot wallet. Never use your main wallet.
# Leave empty to run in scan-only mode (no transactions are built).
WALLET_PRIVATE_KEY=

# --- Strategy -----------------------------------------------------------
# Token you start and end with. Default: USDC.
BASE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Trade size in the base token's smallest unit (USDC has 6 decimals -> 10 USDC).
TRADE_AMOUNT=10000000
# Comma-separated mints to cycle through (BASE -> X -> BASE).
# Defaults: SOL, JUP, BONK, jitoSOL
TARGET_MINTS=So11111111111111111111111111111111111111112,JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN,DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263,J1toso1uCk3RLmjorhTtrVwY9HJ7X1V9yYac6Y7kGCPn
# Minimum profit (base units) after the network/priority fee estimate.
MIN_PROFIT=10000
# Max accounts per leg; keeps both legs small enough to fit in one transaction.
MAX_ACCOUNTS_PER_LEG=24
# Priority fee in micro-lamports per compute unit.
PRIORITY_FEE_MICROLAMPORTS=10000
COMPUTE_UNIT_LIMIT=600000
# Delay between scan rounds (ms). Respect your API rate limits.
SCAN_INTERVAL_MS=2000

# --- Jito (optional) ----------------------------------------------------
# When USE_JITO=true the transaction includes a tip to a Jito tip account and
# is sent to the Jito block engine instead of your RPC. Tip is paid only if the
# transaction lands, and it lands only if the whole arb succeeds.
USE_JITO=false
JITO_TIP_LAMPORTS=10000
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# --- Safety -------------------------------------------------------------
# true  = find opportunities and SIMULATE the transaction, never send.
# false = actually send transactions. Only flip this once you've watched it.
DRY_RUN=true
